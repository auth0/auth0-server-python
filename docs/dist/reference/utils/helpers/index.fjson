{"parents": [], "prev": {"link": "../../error/", "title": "Error"}, "next": {"link": "../../telemetry/", "title": "Telemetry"}, "title": "Helpers", "meta": {}, "body": "<section id=\"module-utils.helpers\">\n<span id=\"helpers\"></span><h1>Helpers<a class=\"headerlink\" href=\"#module-utils.helpers\" title=\"Link to this heading\">\u00b6</a></h1>\n<section id=\"classes\">\n<h2>Classes<a class=\"headerlink\" href=\"#classes\" title=\"Link to this heading\">\u00b6</a></h2>\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.PKCE\" title=\"utils.helpers.PKCE\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">PKCE</span></code></a></p></td>\n<td><p></p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.State\" title=\"utils.helpers.State\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">State</span></code></a></p></td>\n<td><p></p></td>\n</tr>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.URL\" title=\"utils.helpers.URL\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">URL</span></code></a></p></td>\n<td><p></p></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section id=\"functions\">\n<h2>Functions<a class=\"headerlink\" href=\"#functions\" title=\"Link to this heading\">\u00b6</a></h2>\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.build_domain_resolver_context\" title=\"utils.helpers.build_domain_resolver_context\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">build_domain_resolver_context</span></code></a>(...)</p></td>\n<td><p>Build DomainResolverContext from store_options.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.validate_org_claims\" title=\"utils.helpers.validate_org_claims\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">validate_org_claims</span></code></a>(\u2192\u00a0None)</p></td>\n<td><p>Validate org_id or org_name in token claims against the requested organization.</p></td>\n</tr>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"#utils.helpers.validate_resolved_domain_value\" title=\"utils.helpers.validate_resolved_domain_value\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">validate_resolved_domain_value</span></code></a>(\u2192\u00a0str)</p></td>\n<td><p>Validate the value returned by domain resolver.</p></td>\n</tr>\n</tbody>\n</table>\n</section>\n<section id=\"module-contents\">\n<h2>Module Contents<a class=\"headerlink\" href=\"#module-contents\" title=\"Link to this heading\">\u00b6</a></h2>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.PKCE\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">PKCE</span></span><a class=\"headerlink\" href=\"#utils.helpers.PKCE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.PKCE.generate_code_challenge\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">generate_code_challenge</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">code_verifier</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.PKCE.generate_code_challenge\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Generate a PKCE code challenge from a code verifier.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.PKCE.generate_code_verifier\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">generate_code_verifier</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">length</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">int</span></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">64</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.PKCE.generate_code_verifier\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Generate a PKCE code verifier.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.PKCE.generate_random_string\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">generate_random_string</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">length</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">int</span></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">64</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.PKCE.generate_random_string\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Generate a cryptographically secure random string.</p>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">State</span></span><a class=\"headerlink\" href=\"#utils.helpers.State\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State.is_session_ceiling_in_past\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">is_session_ceiling_in_past</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">session_expires_at</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">int</span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">issued_at</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">int</span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">bool</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.State.is_session_ceiling_in_past\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>True when the session ceiling is already in the past at login.</p>\n<p>Compares the ceiling against the ID token <cite>iat</cite>, or wall-clock now when\n<cite>iat</cite> is absent, using the same leeway as is_session_ceiling_reached. A\nNone ceiling means none was asserted and is never treated as expired.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State.is_session_ceiling_reached\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">is_session_ceiling_reached</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">session_expires_at</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">int</span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">bool</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.State.is_session_ceiling_reached\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>True when the session ceiling has been reached (applying negative\nleeway for clock skew). None means no ceiling was asserted, so the\nsession is never expired on this basis.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State.update_state_data\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">update_state_data</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">audience</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">state_data</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">token_endpoint_response</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></span><a class=\"headerlink\" href=\"#utils.helpers.State.update_state_data\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Utility function to update the state with a new response from the token endpoint</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>audience</strong> \u2013 The audience of the token endpoint response</p></li>\n<li><p><strong>state_data</strong> \u2013 The existing state data to update, or None if no state data available</p></li>\n<li><p><strong>token_endpoint_response</strong> \u2013 The response from the token endpoint</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Updated state data</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State.update_state_data_for_connection_token_set\">\n<em class=\"property\"><span class=\"pre\">classmethod</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">update_state_data_for_connection_token_set</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">state_data</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">token_endpoint_response</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></span><a class=\"headerlink\" href=\"#utils.helpers.State.update_state_data_for_connection_token_set\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Update state data with connection token set information</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>options</strong> \u2013 Options containing connection details</p></li>\n<li><p><strong>state_data</strong> \u2013 Existing state data</p></li>\n<li><p><strong>token_endpoint_response</strong> \u2013 Response from token endpoint</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Updated state data</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.State.SESSION_EXPIRY_LEEWAY_SECONDS\">\n<span class=\"sig-name descname\"><span class=\"pre\">SESSION_EXPIRY_LEEWAY_SECONDS</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">30</span></em><a class=\"headerlink\" href=\"#utils.helpers.State.SESSION_EXPIRY_LEEWAY_SECONDS\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.URL\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">URL</span></span><a class=\"headerlink\" href=\"#utils.helpers.URL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.URL.build_url\">\n<em class=\"property\"><span class=\"pre\">static</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">build_url</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">base_url</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">params</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.URL.build_url\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Build a complete URL by appending query parameters to a base URL.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>base_url</strong> \u2013 The base URL without query parameters.</p></li>\n<li><p><strong>params</strong> \u2013 A dictionary of query parameters to add.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The complete URL with the query parameters appended.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.URL.create_logout_url\">\n<em class=\"property\"><span class=\"pre\">static</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">create_logout_url</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">domain</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">client_id</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">return_to</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">federated</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">bool</span></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">False</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.URL.create_logout_url\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Create an Auth0 logout URL.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>domain</strong> \u2013 Auth0 domain.</p></li>\n<li><p><strong>client_id</strong> \u2013 Auth0 client ID.</p></li>\n<li><p><strong>return_to</strong> \u2013 Optional URL to redirect to after logout.</p></li>\n<li><p><strong>federated</strong> \u2013 When True, add <cite>federated</cite> so Auth0 also ends the upstream\nIdP session. Its presence is the signal; the value is ignored.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The complete logout URL.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.URL.parse_url_params\">\n<em class=\"property\"><span class=\"pre\">static</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">parse_url_params</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">url</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">]</span></span></span></span><a class=\"headerlink\" href=\"#utils.helpers.URL.parse_url_params\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Parse the query parameters from a URL.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>url</strong> \u2013 The URL to parse.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>A dictionary of query parameters, converting list values to a single string.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.URL.validate_https_redirect_target\">\n<em class=\"property\"><span class=\"pre\">static</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">validate_https_redirect_target</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">url</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">None</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.URL.validate_https_redirect_target\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Require url to be an absolute https URL (http allowed only for localhost/loopback).</p>\n<p>Raises MissingRequiredArgumentError if blank, InvalidArgumentError otherwise.</p>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py function\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.build_domain_resolver_context\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">build_domain_resolver_context</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">store_options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span><span class=\"p\"><span class=\"pre\">[</span></span><span class=\"pre\">str</span><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">auth0_server_python.auth_types.DomainResolverContext</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.build_domain_resolver_context\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Build DomainResolverContext from store_options.</p>\n<p>Extracts request information in a framework-agnostic way using duck typing.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>store_options</strong> \u2013 Dictionary containing \u2018request\u2019 and \u2018response\u2019 objects</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>DomainResolverContext with extracted request data</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py function\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.validate_org_claims\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">validate_org_claims</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">claims</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">dict</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">expected_org</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">None</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.validate_org_claims\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Validate org_id or org_name in token claims against the requested organization.</p>\n<dl class=\"simple\">\n<dt>Uses expected_org prefix to determine which claim to check:</dt><dd><ul class=\"simple\">\n<li><p>\u2018<a href=\"#id1\"><span class=\"problematic\" id=\"id2\">org_</span></a>\u2019 prefix  \u2192 validate claims[\u2018org_id\u2019] exact match (case-sensitive)</p></li>\n<li><p>no prefix      \u2192 validate claims[\u2018org_name\u2019] case-insensitive match (NFC-normalized)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"../../error/#error.OrganizationTokenValidationError\" title=\"error.OrganizationTokenValidationError\"><strong>OrganizationTokenValidationError</strong></a> \u2013 if the claim is missing, not a string, or mismatched.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py function\">\n<dt class=\"sig sig-object py\" id=\"utils.helpers.validate_resolved_domain_value\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">utils.helpers.</span></span><span class=\"sig-name descname\"><span class=\"pre\">validate_resolved_domain_value</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">domain_value</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">Any</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><span class=\"pre\">str</span></span></span><a class=\"headerlink\" href=\"#utils.helpers.validate_resolved_domain_value\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Validate the value returned by domain resolver.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>domain_value</strong> \u2013 The value returned by the domain resolver</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The validated domain string</p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"../../error/#error.DomainResolverError\" title=\"error.DomainResolverError\"><strong>DomainResolverError</strong></a> \u2013 If the returned value is invalid</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["reference/telemetry/index", "Telemetry", "N", "next"], ["reference/error/index", "Error", "P", "previous"]], "sourcename": "reference/utils/helpers/index.rst.txt", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Helpers</a><ul>\n<li><a class=\"reference internal\" href=\"#classes\">Classes</a></li>\n<li><a class=\"reference internal\" href=\"#functions\">Functions</a></li>\n<li><a class=\"reference internal\" href=\"#module-contents\">Module Contents</a><ul>\n<li><a class=\"reference internal\" href=\"#utils.helpers.PKCE\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PKCE</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#utils.helpers.PKCE.generate_code_challenge\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PKCE.generate_code_challenge()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.PKCE.generate_code_verifier\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PKCE.generate_code_verifier()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.PKCE.generate_random_string\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PKCE.generate_random_string()</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State.is_session_ceiling_in_past\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State.is_session_ceiling_in_past()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State.is_session_ceiling_reached\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State.is_session_ceiling_reached()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State.update_state_data\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State.update_state_data()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State.update_state_data_for_connection_token_set\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State.update_state_data_for_connection_token_set()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.State.SESSION_EXPIRY_LEEWAY_SECONDS\"><code class=\"docutils literal notranslate\"><span class=\"pre\">State.SESSION_EXPIRY_LEEWAY_SECONDS</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.URL\"><code class=\"docutils literal notranslate\"><span class=\"pre\">URL</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#utils.helpers.URL.build_url\"><code class=\"docutils literal notranslate\"><span class=\"pre\">URL.build_url()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.URL.create_logout_url\"><code class=\"docutils literal notranslate\"><span class=\"pre\">URL.create_logout_url()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.URL.parse_url_params\"><code class=\"docutils literal notranslate\"><span class=\"pre\">URL.parse_url_params()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.URL.validate_https_redirect_target\"><code class=\"docutils literal notranslate\"><span class=\"pre\">URL.validate_https_redirect_target()</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.build_domain_resolver_context\"><code class=\"docutils literal notranslate\"><span class=\"pre\">build_domain_resolver_context()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.validate_org_claims\"><code class=\"docutils literal notranslate\"><span class=\"pre\">validate_org_claims()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#utils.helpers.validate_resolved_domain_value\"><code class=\"docutils literal notranslate\"><span class=\"pre\">validate_resolved_domain_value()</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "reference/utils/helpers/index", "sidebars": ["about.html", "searchfield.html", "navigation.html", "relations.html", "donate.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0]}