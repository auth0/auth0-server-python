e\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"error.AccessTokenError.code\">\n<span class=\"sig-name descname\"><span class=\"pre\">code</span></span><a class=\"headerlink\" href=\"#error.AccessTokenError.code\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"error.AccessTokenError.name\">\n<span class=\"sig-name descname\"><span class=\"pre\">name</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'AccessTokenError'</span></em><a class=\"headerlink\" href=\"#error.AccessTokenError.name\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n</dd></dl>\n\n<dl class=\"py exception\">\n<dt class=\"sig sig-object py\" id=\"error.AccessTokenForConnectionError\">\n<em class=\"property\"><span class=\"pre\">exception</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">error.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AccessTokenForConnectionError</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">code</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">message</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">str</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#error.AccessTokenForConnectionError\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference internal\" href=\"#error.Auth0Error\" title=\"error.Auth0Error\"><code class=\"xref py py-o