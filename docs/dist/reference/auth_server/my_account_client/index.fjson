ernal\" href=\"#auth_server.my_account_client.MyAccountClient.list_connected_accounts\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MyAccountClient.list_connected_accounts()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#auth_server.my_account_client.MyAccountClient.update_authentication_method\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MyAccountClient.update_authentication_method()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#auth_server.my_account_client.MyAccountClient.verify_authentication_method\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MyAccountClient.verify_authentication_method()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#auth_server.my_account_client.MyAccountClient.audience\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MyAccountClient.audience</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "reference/auth_server/my_account_client/index", "sidebars": ["about.html", "navigation.html", "relations.html", "searchbox.html", "donate.html"], "alabaster_version": "0.7.16", "alabaster_version_info": [0, 7, 16]}