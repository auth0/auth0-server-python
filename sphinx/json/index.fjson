{"parents": [], "prev": null, "next": {"link": "auth_schemes/bearer_auth/", "title": "auth_schemes.bearer_auth"}, "title": "auth0-server-python", "meta": null, "body": "<section id=\"auth0-server-python\">\n<h1>auth0-server-python<a class=\"headerlink\" href=\"#auth0-server-python\" title=\"Link to this heading\">\u00b6</a></h1>\n<section id=\"install\">\n<h2>Install<a class=\"headerlink\" href=\"#install\" title=\"Link to this heading\">\u00b6</a></h2>\n<div class=\"highlight-shell notranslate\"><div class=\"highlight\"><pre><span></span>pip<span class=\"w\"> </span>install<span class=\"w\"> </span>auth0-server-python\n<span class=\"c1\"># or, with Poetry</span>\npoetry<span class=\"w\"> </span>add<span class=\"w\"> </span>auth0-server-python\n</pre></div>\n</div>\n<ul class=\"simple\">\n<li><p><a class=\"reference external\" href=\"https://github.com/auth0/auth0-server-python/blob/main/examples\">Examples</a></p></li>\n</ul>\n<div class=\"toctree-wrapper compound\">\n</div>\n</section>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["auth_schemes/bearer_auth/index", "auth_schemes.bearer_auth", "N", "next"]], "sourcename": "index.rst.txt", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">auth0-server-python</a><ul>\n<li><a class=\"reference internal\" href=\"#install\">Install</a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "index", "sidebars": ["about.html", "navigation.html", "relations.html", "searchbox.html", "donate.html"], "alabaster_version": "0.7.16", "alabaster_version_info": [0, 7, 16]}