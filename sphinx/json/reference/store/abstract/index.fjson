{"parents": [{"link": "../../", "title": "API Reference"}, {"link": "../", "title": "store"}], "prev": {"link": "../", "title": "store"}, "next": {"link": "../../telemetry/", "title": "telemetry"}, "title": "store.abstract", "meta": {}, "body": "<section id=\"module-store.abstract\">\n<span id=\"store-abstract\"></span><h1>store.abstract<a class=\"headerlink\" href=\"#module-store.abstract\" title=\"Link to this heading\">\u00b6</a></h1>\n<p class=\"rubric\">Import</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">auth0_server_python.store.abstract</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"p\">(</span>\n    <span class=\"n\">AbstractDataStore</span><span class=\"p\">,</span>\n    <span class=\"n\">StateStore</span><span class=\"p\">,</span>\n    <span class=\"n\">TransactionStore</span><span class=\"p\">,</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n<section id=\"module-contents\">\n<h2>Module Contents<a class=\"headerlink\" href=\"#module-contents\" title=\"Link to this heading\">\u00b6</a></h2>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"store.abstract.AbstractDataStore\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">AbstractDataStore</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#dict\" title=\"(in Python v3.15)\"><span class=\"pre\">dict</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.15)\"><sp